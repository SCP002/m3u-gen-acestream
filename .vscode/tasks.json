{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go: format, sort imports, lint",
      "detail": "Runs goimports, golines at 120 columns, then golangci-lint --fix; findings are reported as warnings.",
      "type": "shell",
      "command": "./format.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "golangci-lint",
        "severity": "warning",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    }
  ]
}
